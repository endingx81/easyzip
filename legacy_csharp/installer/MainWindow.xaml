<Window x:Class="EasyZipSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyZip 1.0.0 설치 마법사" Height="440" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/assets/EasyZip.ico"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Malgun Gothic">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <Image Source="pack://application:,,,/assets/EasyZip.png" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EasyZip 설치를 시작합니다" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="초고속 멀티스레드 압축 &amp; 알집(ALZ/EGG) 완벽 지원 초경량 압축 관리자" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Separator Margin="0,12,0,0" Background="#E2E8F0"/>
            </StackPanel>
        </Border>

        <!-- 설치 경로 선택 -->
        <GroupBox Grid.Row="1" Header="설치 폴더" Padding="10" Margin="0,0,0,14" BorderBrush="#E2E8F0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtInstallPath" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                         Padding="8,0" Background="White" BorderBrush="#CBD5E1"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="찾아보기..." Width="85" Height="32" Margin="8,0,0,0"
                        Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnBrowse_Click"/>
            </Grid>
        </GroupBox>

        <!-- 옵션 선택 및 진행 상태 -->
        <Grid Grid.Row="2">
            <!-- 1. 옵션 화면 -->
            <StackPanel x:Name="PanelOptions" Visibility="Visible">
                <GroupBox Header="설치 구성 옵션" Padding="12" BorderBrush="#E2E8F0">
                    <StackPanel>
                        <CheckBox x:Name="ChkDesktopShortcut" Content="바탕 화면에 바로가기 아이콘 생성" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkStartMenu" Content="시작 메뉴 프로그램 목록에 등록" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkContextMenu" Content="윈도우 탐색기 마우스 우클릭 메뉴 등록 (새 폴더 포함)" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkFileAssoc" Content="압축 파일 확장자 연결 (.zip, .7z, .rar, .tar, .alz, .egg 등)" IsChecked="True"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- 2. 설치 진행 화면 -->
            <StackPanel x:Name="PanelProgress" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TxtProgressStatus" Text="파일 복사 및 설치 중..." FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>
                <ProgressBar x:Name="ProgressBarInstall" Height="14" IsIndeterminate="True" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtDetailStatus" Text="준비 중..." FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Grid>

        <!-- 하단 버튼 -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <CheckBox x:Name="ChkLaunchAfter" Content="설치 완료 후 EasyZip 실행" IsChecked="True" VerticalAlignment="Center" Foreground="#475569"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="BtnInstall" Content="설치 시작" Width="100" Height="34" Margin="0,0,8,0"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnInstall_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="BtnCancel" Content="취소" Width="75" Height="34"
                        Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

