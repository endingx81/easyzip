<Window x:Class="EasyZip.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyZip - 초고속 작업 진행" Height="280" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/assets/EasyZip.ico"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Malgun Gothic">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 & 아이콘 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Image Source="pack://application:,,,/assets/EasyZip.png" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtTitle" Text="초고속 압축 풀기 진행 중..." FontSize="16" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtPercent" Text="0%" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 프로그레스 바 -->
        <ProgressBar x:Name="ProgressBarMain" Grid.Row="1" Height="14" Value="0" Maximum="100" Margin="0,0,0,12"
                     Foreground="#2563EB" Background="#E5E7EB" BorderThickness="0"/>

        <!-- 현재 처리 파일 -->
        <TextBlock x:Name="TxtCurrentFile" Grid.Row="2" Text="준비 중..." 
                   Foreground="#4B5563" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

        <!-- 상세 통계 정보 (속도, 남은시간, 용량) -->
        <Border Grid.Row="3" Background="#F3F4F6" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="처리 속도" FontSize="11" Foreground="#6B7280"/>
                    <TextBlock x:Name="TxtSpeed" Text="0.0 MB/s" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="남은 시간" FontSize="11" Foreground="#6B7280"/>
                    <TextBlock x:Name="TxtRemaining" Text="계산 중..." FontSize="13" FontWeight="SemiBold" Foreground="#1F2937"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="처리량 / 전체" FontSize="11" Foreground="#6B7280"/>
                    <TextBlock x:Name="TxtBytes" Text="0 B / 0 B" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 하단 컨트롤: 완료 후 열기 & 취소 -->
        <DockPanel Grid.Row="4" VerticalAlignment="Bottom">
            <CheckBox x:Name="ChkOpenFolder" Content="완료 후 폴더 열기" IsChecked="false" VerticalAlignment="Center" Foreground="#374151"/>
            <Button x:Name="BtnCancel" Content="취소" Width="80" Height="30" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Background="#EF4444" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>
    </Grid>
</Window>

