<Window x:Class="EasyZip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyZip - 초고속 압축 관리자" Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assets/EasyZip.ico"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Malgun Gothic"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!-- 툴바 버튼 스타일 -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 사이드바 버튼 스타일 -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 툴바 -->
            <RowDefinition Height="Auto"/>
            <!-- 주소 / 현재 아카이브 바 -->
            <RowDefinition Height="Auto"/>
            <!-- 메인 뷰어 영역 -->
            <RowDefinition Height="*"/>
            <!-- 상태 바 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 상단 툴바 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/assets/EasyZip.png" Width="22" Height="22" Margin="4,0,10,0" VerticalAlignment="Center"/>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnOpenArchive_Click" ToolTip="압축 파일 열기 (Ctrl+O)">
                        <TextBlock Text="열기" FontWeight="SemiBold"/>
                    </Button>

                    <Button x:Name="BtnToolbarExtract" Style="{StaticResource ToolbarButtonStyle}" Click="BtnExtract_Click" ToolTip="현재 압축 파일 풀기">
                        <TextBlock Text="압축 풀기" FontWeight="Bold" Foreground="#2563EB"/>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnCompress_Click" ToolTip="새 압축 파일 만들기">
                        <TextBlock Text="압축하기" FontWeight="SemiBold"/>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4"/>

                    <Button x:Name="BtnToolbarClose" Style="{StaticResource ToolbarButtonStyle}" Click="BtnCloseArchive_Click" ToolTip="현재 압축 파일 닫기">
                        <TextBlock Text="닫기" FontWeight="Medium"/>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnUp_Click" ToolTip="상위 폴더로 이동">
                        <TextBlock Text="상위로" FontWeight="Medium"/>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnRefresh_Click" ToolTip="새로고침">
                        <TextBlock Text="새로고침" FontWeight="Medium"/>
                    </Button>

                    <Button x:Name="BtnToggleTree" Style="{StaticResource ToolbarButtonStyle}" Click="BtnToggleTree_Click" ToolTip="좌측 폴더 트리 패널 보기/숨기기">
                        <TextBlock Text="폴더 트리" FontWeight="Medium"/>
                    </Button>
                </StackPanel>

                <!-- 우측 환경설정 버튼 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnSettings_Click">
                        <TextBlock Text="환경설정" FontWeight="SemiBold" Foreground="#334155"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. 주소 및 경로 표시줄 -->
        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Content="◀" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnBack_Click" ToolTip="뒤로"/>
                    <Button Content="▶" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnForward_Click" ToolTip="앞으로"/>
                    <Button Content="⬆" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnUp_Click" ToolTip="상위 폴더"/>
                </StackPanel>

                <TextBox x:Name="TxtCurrentPath" Grid.Column="1" Height="30" VerticalContentAlignment="Center" 
                         Padding="8,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                         FontSize="13" KeyDown="TxtCurrentPath_KeyDown"/>

                <Button Grid.Column="2" Content="이동" Width="55" Height="30" Margin="6,0,10,0"
                        Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnGo_Click"/>

                <!-- 아카이브 실시간 검색/필터 -->
                <Grid Grid.Column="3" Width="180">
                    <TextBox x:Name="TxtSearch" Height="30" VerticalContentAlignment="Center"
                             Padding="26,0,8,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                             FontSize="12" TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="🔍" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="아카이브 내 검색..." FontSize="12" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. 메인 콘텐츠 영역 (홈 화면 / 압축 파일 내부 뷰 / 컴퓨터 탐색기 뷰) -->
        <Grid Grid.Row="2" Background="White">
            
            <!-- [화면 1] 압축 파일이 열리지 않았을 때의 시작 홈 화면 (Drop Zone) -->
            <Grid x:Name="PanelHome" Visibility="Visible" Background="#FAFAFA">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/assets/EasyZip.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="EasyZip 초고속 압축 관리자" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="압축 파일을 여기에 끌어다 놓거나, 아래 버튼을 눌러 작업을 시작하세요." FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Width="150" Height="44" Margin="0,0,12,0" Background="#2563EB" Foreground="White"
                                FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnOpenArchive_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="압축 파일 열기"/>
                        </Button>

                        <Button Width="150" Height="44" Background="#F1F5F9" Foreground="#1E293B"
                                FontWeight="SemiBold" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnCompress_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="새로 압축하기"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="* ZIP, 7Z, RAR, ALZ, EGG, TAR, GZ, BZ2, XZ, ISO, CAB 등 모든 압축 포맷 지원" 
                               FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                </StackPanel>
            </Grid>

            <!-- [화면 2] 압축 파일 내부 탐색기 모드 (핵심 메인 뷰!) -->
            <Grid x:Name="PanelArchive" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <!-- 좌측: 압축 파일 내부 폴더 트리 패널 -->
                    <ColumnDefinition x:Name="ColFolderTree" Width="220" MinWidth="130" MaxWidth="500"/>
                    <!-- 분할선 (드래그 조절 가능) -->
                    <ColumnDefinition Width="4"/>
                    <!-- 우측: 선택된 폴더 내 파일/폴더 리스트 -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측: 폴더 구조 트리 패널 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 트리 상단 타이틀 -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                            <DockPanel>
                                <TextBlock Text="📁 폴더 구조" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="4,2" Margin="0,0,4,0"
                                            ToolTip="모든 하위 폴더 접기" Click="BtnCollapseAll_Click">
                                        <TextBlock Text="⊟" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="4,2" 
                                            ToolTip="폴더 트리 새로고침" Click="BtnRefreshTree_Click">
                                        <TextBlock Text="↻" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 압축 파일 내부 폴더 트리뷰 -->
                        <TreeView x:Name="TreeArchiveFolders" Grid.Row="1"
                                  BorderThickness="0" Background="Transparent"
                                  Padding="4,6"
                                  SelectedItemChanged="TreeArchiveFolders_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <Image Source="{Binding FolderIcon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="#1E293B"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- 중앙 조절용 GridSplitter -->
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="#F1F5F9" ShowsPreview="False" Cursor="SizeWE"/>

                <!-- 우측 파일 목록 뷰 -->
                <Grid Grid.Column="2">
                    <ListView x:Name="ListArchiveItems"
                              BorderThickness="0" Background="Transparent"
                              MouseDoubleClick="ListArchiveItems_MouseDoubleClick"
                              SelectionChanged="ListArchiveItems_SelectionChanged">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="열기 / 실행" Click="MenuArchiveOpen_Click"/>
                                <MenuItem Header="선택한 파일 압축 풀기..." Click="MenuArchiveExtractSelected_Click"/>
                                <Separator/>
                                <MenuItem Header="전체 압축 풀기..." Click="BtnExtract_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="이름" Width="380">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding FileIcon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="원본 크기" DisplayMemberBinding="{Binding FormattedSize}" Width="120"/>
                                <GridViewColumn Header="압축 크기" DisplayMemberBinding="{Binding FormattedCompressedSize}" Width="120"/>
                                <GridViewColumn Header="압축률" DisplayMemberBinding="{Binding CompressionRatio}" Width="85"/>
                                <GridViewColumn Header="수정 일시" DisplayMemberBinding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="145"/>
                                <GridViewColumn Header="CRC32" DisplayMemberBinding="{Binding Crc}" Width="95"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- 4. 하단 상태 표시줄 -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="TxtStatusLeft" Text="준비 완료" Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusRight" Text="EasyZip Ultra Engine (Active)" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Foreground="#2563EB" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
