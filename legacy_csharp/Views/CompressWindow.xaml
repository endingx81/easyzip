<Window x:Class="EasyZip.Views.CompressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="압축하기 - EasyZip" Height="500" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/assets/EasyZip.ico"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Malgun Gothic"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0. 압축 파일 저장 경로 -->
            <RowDefinition Height="Auto"/>
            <!-- 1. 압축 대상 항목 목록 및 추가/삭제 버튼 -->
            <RowDefinition Height="*"/>
            <!-- 2. 압축 설정 -->
            <RowDefinition Height="Auto"/>
            <!-- 3. 하단 액션 버튼 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. 저장 경로 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="압축 파일 저장 경로:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtArchivePath" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                         FontSize="13" Background="White" BorderBrush="#CBD5E1"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="찾아보기..." Width="85" Height="34" Margin="8,0,0,0"
                        Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnBrowse_Click"/>
            </Grid>
        </StackPanel>

        <!-- 1. 대상 항목 목록 -->
        <GroupBox Grid.Row="1" Header="압축할 대상 항목 (파일 또는 폴더를 드래그하여 추가)" Padding="8" Margin="0,0,0,12" BorderBrush="#E2E8F0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="ListSources" Grid.Row="0" MinHeight="100" BorderBrush="#CBD5E1" Background="White"
                         SelectionMode="Extended"/>

                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="+ 파일 추가" Padding="10,5" Margin="0,0,6,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnAddFiles_Click"/>
                        <Button Content="+ 폴더 추가" Padding="10,5" Margin="0,0,6,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnAddFolder_Click"/>
                        <Button Content="- 선택 삭제" Padding="10,5" Margin="0,0,6,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnRemoveSelected_Click"/>
                        <Button Content="전체 비우기" Padding="10,5" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnClearAll_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSourcesInfo" DockPanel.Dock="Right" Text="0개 항목" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#64748B" FontSize="12"/>
                </DockPanel>
            </Grid>
        </GroupBox>

        <!-- 2. 압축 설정 -->
        <GroupBox Grid.Row="2" Header="압축 설정" Padding="10" Margin="0,0,0,14" BorderBrush="#E2E8F0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="압축 형식:" VerticalAlignment="Center" Foreground="#475569"/>
                <ComboBox x:Name="CmbFormat" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="ZIP (.zip) - 모든 OS 및 기기 표준 호환"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="압축 레벨:" VerticalAlignment="Center" Foreground="#475569" Margin="0,8,0,0"/>
                <ComboBox x:Name="CmbLevel" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectedIndex="1" Margin="0,8,0,0">
                    <ComboBoxItem Content="초고속 (Fastest) - 가장 빠른 속도"/>
                    <ComboBoxItem Content="보통 (Optimal) - 균형 잡힌 압축률"/>
                    <ComboBoxItem Content="최대 압축 (SmallestSize)"/>
                    <ComboBoxItem Content="무압축 (NoCompression) - 초고속 보관용"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- 3. 하단 액션 버튼 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="BtnStart" Content="초고속 압축 시작" Width="140" Height="36" Margin="0,0,10,0"
                    Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13"
                    BorderThickness="0" Cursor="Hand" Click="BtnStart_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="BtnCancel" Content="취소" Width="85" Height="36"
                    Background="#E2E8F0" Foreground="#334155" FontSize="13"
                    BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
