#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#pragma code_page(65001) // UTF-8

// Application Icon
IDI_APP_ICON        ICON    "EasyZip.ico"

// Main Menu
IDR_MAIN_MENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "압축 풀기(&X)...\tF4",            IDM_FILE_EXTRACT_ALL
        MENUITEM "선택 파일 풀기(&S)...",          IDM_FILE_EXTRACT_SELECTED
        MENUITEM SEPARATOR
        MENUITEM "닫기(&C)",                        IDM_FILE_CLOSE
        MENUITEM "끝내기(&X)\tAlt+F4",              IDM_FILE_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "전체 선택(&A)\tCtrl+A",           IDM_EDIT_SELECT_ALL
        MENUITEM "선택 반전(&I)",                   IDM_EDIT_INVERT_SELECT
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "새로 고침(&R)\tF5",               IDM_VIEW_REFRESH
        MENUITEM "상위 폴더로(&U)\tBackspace",       IDM_VIEW_UP_FOLDER
    END
    POPUP "도구(&T)"
    BEGIN
        MENUITEM "환경설정(&P)...",                 IDM_TOOLS_SETTINGS
    END
    POPUP "코드페이지(&C)"
    BEGIN
        MENUITEM "자동 선택 (기본값)\tCtrl+Shift+A", IDM_CODEPAGE_AUTO
        MENUITEM SEPARATOR
        MENUITEM "한국어 (CP949 / EUC-KR)",             IDM_CODEPAGE_CP949
        MENUITEM "유니코드 (UTF-8)",                    IDM_CODEPAGE_UTF8
        MENUITEM "일본어 (Shift-JIS / CP932)",          IDM_CODEPAGE_CP932
        MENUITEM "중국어 간체 (GBK / CP936)",           IDM_CODEPAGE_CP936
        MENUITEM "중국어 번체 (Big5 / CP950)",          IDM_CODEPAGE_CP950
        MENUITEM "서유럽어 (Windows-1252)",             IDM_CODEPAGE_CP1252
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "EasyZip 정보(&A)...",             IDM_HELP_ABOUT
    END
END

// List Context Menu
IDR_LIST_CONTEXT MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "선택 파일 압축 풀기(&E)...",      IDM_FILE_EXTRACT_SELECTED
        MENUITEM SEPARATOR
        MENUITEM "전체 선택(&A)",                   IDM_EDIT_SELECT_ALL
        MENUITEM "선택 반전(&I)",                   IDM_EDIT_INVERT_SELECT
        MENUITEM SEPARATOR
        MENUITEM "새로 고침(&R)\tF5",               IDM_VIEW_REFRESH
    END
END

// Tree Context Menu
IDR_TREE_CONTEXT MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "이 폴더 압축 풀기(&E)...",        IDM_FILE_EXTRACT_SELECTED
    END
END

// Accelerator Table
IDA_ACCEL ACCELERATORS
BEGIN
    "A",            IDM_EDIT_SELECT_ALL,    VIRTKEY, CONTROL
    VK_F4,          IDM_FILE_EXTRACT_ALL,   VIRTKEY
    VK_F5,          IDM_VIEW_REFRESH,       VIRTKEY
    VK_BACK,        IDM_VIEW_UP_FOLDER,     VIRTKEY
END

// Dialogs

// 1. Progress Dialog
IDD_PROGRESS DIALOGEX 0, 0, 340, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EasyZip 작업 진행 중"
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    LTEXT           "준비 중...", IDC_LBL_STATUS, 14, 12, 312, 14, SS_LEFTNOWORDWRAP | SS_ENDELLIPSIS
    CONTROL         "", IDC_PROG_BAR, PROGRESS_CLASS, PBS_SMOOTH | WS_BORDER, 14, 30, 312, 14
    LTEXT           "진행: 0 / 0 파일 (0 B)", IDC_LBL_PROCESSED, 14, 52, 312, 12, SS_LEFTNOWORDWRAP
    LTEXT           "속도: 0 MB/s", IDC_LBL_SPEED, 14, 68, 150, 12, SS_LEFTNOWORDWRAP
    LTEXT           "남은 시간: 계산 중...", IDC_LBL_ETA, 170, 68, 156, 12, SS_LEFTNOWORDWRAP
    
    CONTROL         "완료 후 대상 폴더 열기", IDC_CHK_OPEN_FOLDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 92, 160, 14
    
    DEFPUSHBUTTON   "일시정지", IDC_BTN_PAUSE, 206, 134, 56, 16
    PUSHBUTTON      "취소", IDC_BTN_CANCEL, 270, 134, 56, 16
END

// 2. Compress Dialog
IDD_COMPRESS DIALOGEX 0, 0, 360, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EasyZip 압축하기"
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    GROUPBOX        "압축 대상", IDC_STATIC, 12, 10, 336, 42
    LTEXT           "선택된 파일/폴더 요약", IDC_LBL_SOURCE_SUMMARY, 22, 26, 316, 18, SS_LEFTNOWORDWRAP | SS_ENDELLIPSIS

    GROUPBOX        "저장 위치 및 형식", IDC_STATIC, 12, 58, 336, 144
    LTEXT           "저장 파일명:", IDC_STATIC, 22, 74, 55, 12
    EDITTEXT        IDC_EDT_DEST_PATH, 80, 72, 206, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기...", IDC_BTN_BROWSE_DEST, 292, 72, 48, 14

    LTEXT           "압축 포맷:", IDC_STATIC, 22, 96, 55, 12
    COMBOBOX        IDC_CMB_FORMAT, 80, 94, 90, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "압축 방식:", IDC_STATIC, 185, 96, 45, 12
    COMBOBOX        IDC_CMB_LEVEL, 235, 94, 105, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "비밀번호:", IDC_STATIC, 22, 120, 55, 12
    EDITTEXT        IDC_EDT_PASSWORD, 80, 118, 140, 14, ES_PASSWORD | ES_AUTOHSCROLL

    LTEXT           "분할 압축:", IDC_STATIC, 22, 144, 55, 12
    COMBOBOX        IDC_CMB_SPLIT_SIZE, 80, 142, 90, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "스레드 수:", IDC_STATIC, 185, 144, 45, 12
    COMBOBOX        IDC_CMB_THREADS, 235, 142, 105, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    DEFPUSHBUTTON   "압축 시작(&S)", IDOK, 226, 212, 58, 18
    PUSHBUTTON      "취소", IDCANCEL, 290, 212, 58, 18
END

// 3. Settings Dialog
IDD_SETTINGS DIALOGEX 0, 0, 360, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EasyZip 환경설정"
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TAB_SETTINGS, "SysTabControl32", WS_TABSTOP, 10, 10, 340, 204

    // Tab 0: File Association
    GROUPBOX        "지원 파일 형식 연결", IDC_GRP_ASSOC, 20, 34, 320, 164
    CONTROL         "ZIP (.zip)", IDC_CHK_EXT_ZIP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 52, 70, 12
    CONTROL         "7-Zip (.7z)", IDC_CHK_EXT_7Z, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 52, 75, 12
    CONTROL         "RAR (.rar)", IDC_CHK_EXT_RAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 195, 52, 70, 12
    CONTROL         "ALZ (.alz)", IDC_CHK_EXT_ALZ, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 270, 52, 60, 12
    CONTROL         "EGG (.egg)", IDC_CHK_EXT_EGG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 74, 70, 12
    CONTROL         "TAR (.tar)", IDC_CHK_EXT_TAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 74, 75, 12
    CONTROL         "GZ / TGZ (.gz)", IDC_CHK_EXT_GZ, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 195, 74, 70, 12
    CONTROL         "BZ2 (.bz2)", IDC_CHK_EXT_BZ2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 270, 74, 60, 12
    CONTROL         "XZ (.xz)", IDC_CHK_EXT_XZ, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 96, 70, 12
    CONTROL         "ISO (.iso)", IDC_CHK_EXT_ISO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 96, 75, 12
    LTEXT           "※ Windows 11: 아래 버튼을 눌러 기본 앱을 EasyZip으로 지정하세요.", IDC_LBL_WIN11_HINT, 30, 120, 290, 12, SS_LEFTNOWORDWRAP
    PUSHBUTTON      "전체 선택", IDC_BTN_SELECT_ALL_ASSOC, 30, 142, 50, 16
    PUSHBUTTON      "전체 해제", IDC_BTN_CLEAR_ALL_ASSOC, 86, 142, 50, 16
    PUSHBUTTON      "Windows 11 기본 앱 설정 열기...", IDC_BTN_WIN11_DEFAULT_APPS, 146, 142, 170, 16

    // Tab 1: Shell Integration
    GROUPBOX        "윈도우 탐색기 우클릭 메뉴 연동", IDC_GRP_SHELL, 20, 34, 320, 172
    CONTROL         "윈도우 탐색기 컨텍스트 메뉴 사용 (EasyZipShell)", IDC_CHK_ENABLE_SHELL_MENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 48, 260, 11
    CONTROL         "하위 메뉴(Cascading Menu)로 묶어서 표시", IDC_CHK_SHOW_SUBMENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 61, 260, 11
    LTEXT           "표시할 메뉴 항목 선택:", IDC_LBL_SHELL_ITEMS, 30, 75, 260, 10
    CONTROL         "새 폴더 만들기(&N) (최상단 노출)", IDC_CHK_MENU_NEW_FOLDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 38, 88, 260, 11
    CONTROL         "여기에 압축 풀기(&X)", IDC_CHK_MENU_EXTRACT_HERE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 38, 101, 260, 11
    CONTROL         "알아서 풀기(&A) (폴더 유무 자동 판별)", IDC_CHK_MENU_EXTRACT_SMART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 38, 114, 260, 11
    CONTROL         """{파일명}""에 압축 풀기 (단일 파일 선택 시)", IDC_CHK_MENU_EXTRACT_FOLDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 38, 127, 260, 11
    CONTROL         "각각의 폴더에 압축 풀기 (다중 파일 선택 시)", IDC_CHK_MENU_EXTRACT_EACH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 38, 140, 260, 11
    CONTROL         "빠른 ZIP 압축(&Z)", IDC_CHK_MENU_FAST_ZIP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 38, 153, 260, 11
    CONTROL         "EasyZip으로 압축하기(&C)...", IDC_CHK_MENU_COMPRESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 38, 166, 260, 11

    // Tab 2: General Options
    GROUPBOX        "기본 동작 설정", IDC_GRP_GENERAL, 20, 34, 320, 140
    CONTROL         "압축 풀기 완료 후 자동으로 대상 폴더 열기", IDC_CHK_DEF_OPEN_FOLDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 56, 260, 14

    DEFPUSHBUTTON   "확인", IDOK, 226, 222, 58, 18
    PUSHBUTTON      "취소", IDCANCEL, 290, 222, 58, 18
END

// 4. About Dialog
IDD_ABOUT DIALOGEX 0, 0, 240, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EasyZip 정보"
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    ICON            IDI_APP_ICON, IDC_STATIC, 16, 16, 32, 32
    LTEXT           "EasyZip v1.1.1 (x64 Native)", IDC_STATIC, 60, 16, 160, 12, SS_NOPREFIX
    LTEXT           "초고속 네이티브 C++ 아카이버", IDC_STATIC, 60, 32, 160, 12
    LTEXT           "Copyright (C) 2026 ai-open.kr. All rights reserved.", IDC_STATIC, 60, 50, 168, 18
    LTEXT           "ZIP, 7Z, RAR, ALZ, EGG, TAR, GZ, BZ2, XZ 지원", IDC_STATIC, 60, 72, 168, 12
    DEFPUSHBUTTON   "확인", IDOK, 90, 98, 60, 16
END

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,5,0
PRODUCTVERSION  1,1,5,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName",      "ai-open.kr"
            VALUE "FileDescription",  "EasyZip High Performance Archiver"
            VALUE "FileVersion",      "1.1.5.0"
            VALUE "InternalName",     "EasyZip"
            VALUE "LegalCopyright",   "Copyright (C) 2026 ai-open.kr. All rights reserved."
            VALUE "OriginalFilename", "EasyZip.exe"
            VALUE "ProductName",      "EasyZip"
            VALUE "ProductVersion",   "1.1.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 0x04b0
    END
END
